#include <SPI.h>
#include "Adafruit_MAX31865.h"

// ——— UART2 for reception ———
#define RX2_PIN   16   // wire this to Board 1 pin 17 (TX)
#define TX2_PIN   17   // not used here

void setup() {
  Serial.begin(115200);     // USB serial → your PC
  Serial2.begin(9600, SERIAL_8N1, RX2_PIN, TX2_PIN);

  Serial.println("Board 2 ready — waiting for data...");
}

void loop() {
  // Read complete lines as they arrive
  if (Serial2.available()) {
    String line = Serial2.readStringUntil('\n');
    line.trim();

    if (line.startsWith("T,")) {
      // Parse temperature value after the comma
      float tempC = line.substring(2).toFloat();
      Serial.print("RTD Temp: ");
      Serial.print(tempC, 2);
      Serial.println(" °C");

    } else if (line.startsWith("FAULT,")) {
      Serial.print("RTD FAULT received: ");
      Serial.println(line.substring(6));

    } else if (line.length() > 0) {
      // Catch-all for anything unexpected
      Serial.print("Unknown msg: ");
      Serial.println(line);
    }
  }
}


