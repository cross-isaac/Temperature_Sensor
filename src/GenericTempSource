#include <Arduino.h>
#include <SPI.h>
#include "Adafruit_MAX31865.h"

// ——— SPI pin definitions (VSPI) ———
#define SPI_SCK   18
#define SPI_MOSI  23
#define SPI_MISO  19
#define CS_RTD    15

Adafruit_MAX31865 rtd = Adafruit_MAX31865(CS_RTD, SPI_MOSI, SPI_MISO, SPI_SCK);

void setup() {
  Serial.begin(115200);

  pinMode(CS_RTD, OUTPUT);
  digitalWrite(CS_RTD, HIGH);
  SPI.begin(SPI_SCK, SPI_MISO, SPI_MOSI);

  if (!rtd.begin(MAX31865_3WIRE)) {
    Serial.println("ERROR: MAX31865 not found. Check wiring!");
    while (1) delay(10);
  }

  Serial.println("RTD ready.");
}

void loop() {
  uint8_t fault = rtd.readFault();

  if (fault == 0) {
    float tempC = rtd.temperature(100.0, 430.0);
    // Clean CSV format: "T,23.45"
    Serial.print("T,");
    Serial.println(tempC, 2);
  } else {
    Serial.print("FAULT,0x");
    Serial.println(fault, HEX);
    rtd.clearFault();
  }

  delay(500);  // 1 second — reduce if you want faster
}